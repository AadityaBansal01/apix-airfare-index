# ---------------------------------------------------------------------------
# APIx configuration. Copy to .env; every value below is a working default for
# `make demo`.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://apix:apix@localhost:5433/apix

# --- demo resilience -------------------------------------------------------
# When true, the API and dashboard serve the seeded 30-day dataset instead of
# live scrapes. This is how the demo survives a blocked network or a site
# outage on presentation day. It is ALWAYS labelled as seeded in the UI and in
# the API response metadata -- seeded data is never presented as live.
APIX_USE_SEED_DATA=true
APIX_SEED_DIR=data/seed

# --- scraping policy -------------------------------------------------------
# identified  = one honest, contactable UA token (default, and what we ship)
# rotating    = rotate realistic browser UAs; see apix/net/identity.py for why
#               this is off by default
APIX_IDENTITY_MODE=identified
APIX_MIN_DELAY_SECONDS=6.0
APIX_JITTER_SECONDS=2.0
APIX_MAX_CONCURRENT_PER_ORIGIN=1
# Refuse to crawl when robots.txt cannot be fetched. Do not set this to false.
APIX_FAIL_CLOSED_ON_ROBOTS_ERROR=true
APIX_ROBOTS_TTL_HOURS=12

# --- reference data --------------------------------------------------------
# The MoSPI API negotiates TLS in a way modern OpenSSL rejects by default
# ("unsafe legacy renegotiation disabled"). apix/reference/mospi_cpi.py sets
# ssl.OP_LEGACY_SERVER_CONNECT to work around it. This flag exists so the
# workaround can be disabled if MoSPI ever fixes their endpoint.
MOSPI_API_BASE=https://api.mospi.gov.in/api/esankhyiki
MOSPI_ALLOW_LEGACY_TLS=true
DGCA_TRAFFIC_CSV=data/reference/dgca_city_pair_monthly.csv

# --- api -------------------------------------------------------------------
APIX_API_HOST=0.0.0.0
APIX_API_PORT=8000
APIX_CORS_ORIGINS=http://localhost:5173
